{
  "name": "english-vocabulary-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/core.test.mjs tests/store.test.mjs tests/speech.test.mjs",
    "test:browser": "node tests/browser.test.mjs && node tests/admin-browser.test.mjs && node tests/offline-browser.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-english-vocabulary --only firestore \"node --test tests/rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.6.1",
    "firebase-tools": "14.1.0",
    "playwright": "1.62.1"
  }
}
