rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function english(ns) { return ns == 'english-vocabulary-v1'; }
    function signed() { return request.auth != null; }
    function admin(ns) { return english(ns) && signed() && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function owner(ns, uid) { return english(ns) && signed() && request.auth.uid == uid; }
    function date(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function wordId(s) { return s is string && s.matches('^level[1-6]-[0-9]+$'); }
    function profile(d, id) {
      return d.id == id && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.emoji is string && d.emoji.size() <= 16 && date(d.startDate)
        && d.timeZone is string && d.timeZone.size() <= 80
        && d.courseVersion is string && d.courseVersion.size() <= 100
        && d.status in ['ready','restoring'];
    }
    function validWord(id) {
      return wordId(id) && request.resource.data.id == id
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 6
        && request.resource.data.sequence is int && request.resource.data.sequence > 0
        && request.resource.data.word is string && request.resource.data.word.size() > 0 && request.resource.data.word.size() <= 2000
        && request.resource.data.meaningZh is string && request.resource.data.partOfSpeech is string
        && request.resource.data.exampleEn is string && request.resource.data.exampleZh is string
        && request.resource.data.phrases is list && request.resource.data.phrases.size() <= 3
        && request.resource.data.active is bool
        && request.resource.data.reviewStatus in ['pending','approved'];
    }
    match /apps/{ns}/words/{id} {
      allow read: if english(ns) && signed();
      allow create: if admin(ns) && validWord(id);
      allow update: if admin(ns) && validWord(id)
        && request.resource.data.level == resource.data.level && request.resource.data.sequence == resource.data.sequence;
      allow delete: if false;
    }
    match /apps/{ns}/meta/{id} {
      allow read: if english(ns) && signed();
      allow create, update: if admin(ns) && id in ['current','draft'];
      allow delete: if false;
    }
    match /apps/{ns}/curricula/{version} {
      allow read: if english(ns) && signed();
      allow create: if admin(ns) && request.resource.data.ready == false;
      allow update: if admin(ns) && resource.data.ready == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']);
      allow delete: if false;
      match /days/{day} {
        allow read: if english(ns) && signed();
        allow create: if admin(ns)
          && get(/databases/$(database)/documents/apps/$(ns)/curricula/$(version)).data.ready == false
          && request.resource.data.words is list && request.resource.data.words.size() <= 15
          && request.resource.data.index is int;
        allow update, delete: if false;
      }
    }
    match /apps/{ns}/accounts/{uid} {
      allow read: if owner(ns,uid);
      allow create, update: if owner(ns,uid) && request.resource.data.keys().hasOnly(['names','updatedAt'])
        && request.resource.data.names is map && request.resource.data.names.size() <= 50
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /profiles/{pid} {
        allow read: if owner(ns,uid);
        allow create: if owner(ns,uid) && profile(request.resource.data,pid)
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if owner(ns,uid) && profile(request.resource.data,pid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
        match /progress/{wid} {
          allow read: if owner(ns,uid);
          allow create, update: if owner(ns,uid) && wordId(wid) && request.resource.data.wordId == wid
            && request.resource.data.stage is int && request.resource.data.stage >= 0 && request.resource.data.stage <= 6
            && request.resource.data.updatedAt == request.time
            && (!('nextDue' in request.resource.data) || request.resource.data.nextDue == null || date(request.resource.data.nextDue));
          allow delete: if false;
        }
        match /dailyPlans/{day} {
          allow read: if owner(ns,uid);
          allow create, update: if owner(ns,uid) && date(day) && request.resource.data.date == day
            && request.resource.data.words is list && request.resource.data.words.size() <= 15
            && request.resource.data.reviewIds is list && request.resource.data.reviewDone is list
            && request.resource.data.updatedAt == request.time
            && (!exists(/databases/$(database)/documents/apps/$(ns)/accounts/$(uid)/profiles/$(pid)/dailyPlans/$(day))
              || (request.resource.data.words == resource.data.words && request.resource.data.courseVersion == resource.data.courseVersion));
          allow delete: if false;
        }
        match /reviewEvents/{eid} {
          allow read: if owner(ns,uid);
          allow create: if owner(ns,uid) && request.resource.data.id == eid
            && wordId(request.resource.data.wordId) && date(request.resource.data.actualDate) && date(request.resource.data.planDate)
            && request.resource.data.actualDate >= request.resource.data.planDate
            && request.resource.data.rating in ['remember','hard','forget']
            && request.resource.data.level is int && request.resource.data.level >= 2 && request.resource.data.level <= 6
            && request.resource.data.kind in ['new','review']
            && (request.resource.data.correct != false || request.resource.data.rating != 'remember');
          allow update, delete: if false;
        }
      }
    }
    // No broad wildcard grant. Merge the matches above into existing production rules
    // before deployment; do not overwrite the other application's existing rules.
  }
}
